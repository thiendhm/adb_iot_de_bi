{
  "evaluation": {
    "source": {
      "name": "device_id",
      "display": "source",
      "aggregation": "COUNT"
    },
    "comparison_operator": "GREATER_THAN_OR_EQUAL",
    "threshold": {
      "value": {
        "double_value": 1.0
      }
    },
    "empty_result_state": "OK",
    "notification": {}
  },
  "schedule": {
    "quartz_cron_schedule": "52 10 * * * ?",
    "timezone_id": "Asia/Saigon"
  },
  "query_lines": [
    "WITH pm10_base AS (",
    "    SELECT",
    "        device_id,",
    "        device_name,",
    "        sensor_id,",
    "        metric_name,",
    "        value,",
    "        measured_at,",
    "        _ingested_at,",
    "        date_trunc('hour', _ingested_at) AS hour_window,",
    "        -- Rolling 60-minute median over measured_at (3600 seconds preceding to current row)",
    "        percentile_approx(value, 0.5) OVER (",
    "            ORDER BY CAST(measured_at AS LONG)",
    "            RANGE BETWEEN 3600 PRECEDING AND CURRENT ROW",
    "        ) AS rolling_median_60m",
    "    FROM adb_std.silver.iot_env_measurements",
    "    WHERE metric_name = 'PM10'",
    "      AND value IS NOT NULL",
    "      -- Filter to inspect records from the last 2-3 hours to keep the hourly scan fast",
    "      AND _ingested_at >= current_timestamp() - INTERVAL 24 HOURS",
    "),",
    "threshold_breaches AS (",
    "    SELECT",
    "        *,",
    "        -- First occurrence per hour window (earliest _ingested_at)",
    "        ROW_NUMBER() OVER (",
    "            PARTITION BY hour_window ",
    "            ORDER BY _ingested_at ASC",
    "        ) AS row_num",
    "    FROM pm10_base",
    "    WHERE rolling_median_60m > 15",
    ")",
    "SELECT",
    "    hour_window,",
    "    device_id,",
    "    device_name,",
    "    metric_name,",
    "    value,",
    "    rolling_median_60m,",
    "    measured_at,",
    "    _ingested_at",
    "FROM threshold_breaches",
    "WHERE row_num = 1",
    "  -- Evaluate only breaches belonging to the latest completed/current hour",
    "  AND hour_window >= date_trunc('hour', current_timestamp() - INTERVAL 1 HOUR)",
    "ORDER BY _ingested_at DESC;"
  ],
  "custom_description_lines": [
    "<span style=\"font-size: 12px;\">Hi Admin,</span>",
    "",
    "<span style=\"font-size: 12px;\">Dust value over threshold.</span>",
    "",
    "<span style=\"font-size: 12px;\">Threshold: {{ALERT\\_CONDITION}}</span>",
    "",
    "<span style=\"font-size: 12px;\">Details</span>",
    "",
    "<span style=\"font-size: 12px;\">{{QUERY\\_RESULT\\_TABLE}}</span>"
  ]
}
